      "id": "kappa",
      "wasm": "site/kappa/guest/kappa.wasm",
      "pin": "site/kappa/guest.mjs",
      "modules": [
        "PrismKappa",
        "PrismKappaLabel"
      ],
      "dispatch": "PrismKappaLabel::kappaLabelDispatch",
      "vectors": "spec:kappa",
      "limits": [
        146,
        32,
        292
      ]
    },
    {
