{
  "name": "guests",
  "title": "The page's standalone decision guests",
  "purpose": "Every proved decision the page's Node suites run without the holo, as the core wasm prismpm builds from the very modules the Prism compiles. Each guest is pinned by SHA-256 where the page opens it, and locked to the digest of the modules it was built from, so a guest older than its modules fails GU-01.",
  "guests": [
    {
      "id": "holon",
      "wasm": "site/holon/guest/holon.wasm",
      "pin": "site/holon/guest.mjs",
      "modules": [
        "PrismHolon"
      ],
      "dispatch": "PrismHolon::prismHolonDispatch",
      "vectors": "holon",
      "as": "holon"
    },
    {
      "id": "curate",
      "wasm": "site/holon/guest/curate.wasm",
      "pin": "site/holon/guest.mjs",
