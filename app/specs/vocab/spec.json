{
 "spec": "me/vocabulary/1",
 "comment": "The Prism's vocabulary register: schema.org 30.1 in full (every type, property and enumeration member of its published file) and every term of eleven common schemas, each read from its authority's own published file pinned by SHA-256, and crosswalked onto schema.org. tools/oracle/gen.py reads this spec and writes site/vocab/register.json and the Lean modules in 'lean'; --check refuses them if stale. The crosswalk rows, domains, anchors and property floors are the design's claims (R2), stated here in the model; a claim naming a term its pinned source does not define is refused, and every term no claim maps is kept as residual (schema:additionalProperty or schema:additionalType on schema:Thing), so nothing a source defines is dropped.",
 "schemaorg": {
  "release": "30.1",
  "source": "schemaorg-current-https.jsonld",
  "examples": "schemaorg",
  "statusCodes": [
   "core",
   "pending",
   "extension",
   "superseded"
  ],
  "oracles": [
   {
    "role": "whole",
    "file": "schemaorg-all-https.jsonld",
    "url": "https://raw.githubusercontent.com/schemaorg/schemaorg/5f2d8cdec99b7329459ef6584e94b6a840f88471/data/releases/30.1/schemaorg-all-https.jsonld",
    "sha256": "07e7c663dbc12a0937581745e59a98ed12b8698f38e8e3b03650287d9df88ae5",
    "retrieved": "2026-11-15",
    "why": "the release's whole graph, its current terms and its attic, from the commit the examples are pinned at"
   },
   {
    "role": "context",
    "file": "jsonldcontext.jsonld",
    "url": "https://schema.org/docs/jsonldcontext.jsonld",
    "sha256": "65d0c5d17def9b171b7697bb0929eed17aa32f19af539e15302b6c20479b8930",
    "retrieved": "2026-11-15",
    "why": "the JSON-LD context \"https://schema.org\" names, which the examples are read by; schema.org publishes it unversioned, so a new release changes these bytes and the producer refuses until it is pinned again"
   }
  ],
  "defects": [
   {
    "example": "#eg-0291",
    "term": "Best for the Money",
    "why": "the example gives a review's label as its \"type\", which the schema.org context aliases to @type, so it reads as a type no release defines; the release's own Recommendation examples are otherwise read in full"
   },
   {
    "example": "#eg-0293",
    "term": "Best for the Money",
    "why": "the example gives a review's label as its \"type\", which the schema.org context aliases to @type, so it reads as a type no release defines; the release's own Recommendation examples are otherwise read in full"
   }
  ]
 },
