  "tree": {
    "if": [
      "halted",
      "yes"
    ],
    "then": "refuse",
    "else": {
      "if": [
        "provider",
        "mismatch"
      ],
      "then": "refuse",
      "else": {
        "if": [
          "value",
          "start"
        ],
        "then": {
          "if": [
            "feature",
            "time"
          ],
          "then": {
            "if": [
              "source",
              "note"
            ],
            "then": "skip",
            "else": {
              "if": [
                "source",
                "contact"
              ],
              "then": "skip",
              "else": "direct"
            }
          },
          "else": "skip"
        },
        "else": {
          "if": [
            "value",
            "party"
          ],
          "then": {
            "if": [
              "feature",
              "party"
            ],
            "then": {
              "if": [
                "source",
                "note"
              ],
              "then": "skip",
              "else": "direct"
            },
            "else": "skip"
          },
          "else": {
            "if": [
              "value",
              "shape"
            ],
            "then": {
              "if": [
                "feature",
                "kind"
              ],
              "then": {
                "if": [
                  "provider",
                  "absent"
                ],
                "then": "skip",
                "else": "map"
              },
              "else": "skip"
            },
            "else": {
              "if": [
                "provider",
                "absent"
              ],
              "then": "skip",
              "else": "map"
            }
          }
        }
      }
    }
  },
  "guarantees": [
    {
      "when": [
        [
          "halted",
          "yes"
        ]
      ],
      "always": "refuse",
      "why": "the kill switch stops every mapping"
    },
    {
      "when": [
        [
          "halted",
          "no"
        ],
        [
          "provider",
          "mismatch"
        ]
      ],
      "always": "refuse",
      "why": "bytes that are not the compiled model never touch the owner's data"
    },
    {
      "when": [
        [
          "provider",
          "absent"
        ]
      ],
      "never": [
        "map"
      ],
      "why": "no feature runs without the model compiled into the Prism for it"
    },
    {
      "when": [
        [
          "halted",
          "no"
        ],
        [
          "provider",
          "compiled"
        ],
        [
          "value",
          "text"
        ]
      ],
      "always": "map",
      "why": "the owner's free text is read by every compiled feature, so nothing they wrote is held as a bare string"
    },
    {
      "when": [
        [
          "halted",
          "no"
        ],
        [
          "provider",
          "compiled"
        ],
        [
          "value",
          "subject"
        ]
      ],
      "always": "map",
      "why": "a subject line is free text too"
    },
    {
      "when": [
        [
          "value",
          "start"
        ]
      ],
      "never": [
        "map"
      ],
      "why": "a time the source's schema already types is never re-read by a model"
    },
    {
      "when": [
        [
          "value",
          "party"
        ]
      ],
      "never": [
        "map"
      ],
      "why": "a person the source's schema already names is never re-read by a model"
    },
    {
      "when": [
        [
          "halted",
          "no"
        ],
        [
          "provider",
          "absent"
        ],
        [
          "source",
          "calendar"
        ],
        [
          "value",
          "start"
        ],
        [
          "feature",
          "time"
        ]
      ],
      "always": "direct",
      "why": "a calendar event's own start lands on the Prism's time feature even with no model"
    },
    {
      "when": [
        [
          "source",
          "note"
        ],
        [
          "value",
          "start"
        ]
      ],
      "never": [
        "direct"
      ],
      "why": "the owner's words carry no typed start: their time is read, never assumed"
    },
    {
      "when": [
        [
          "halted",
          "no"
        ],
        [
          "provider",
          "compiled"
        ],
        [
          "value",
          "shape"
        ],
        [
          "feature",
          "kind"
        ]
      ],
      "always": "map",
      "why": "what kind of thing an item is is read from the parts it is built of"
    },
    {
      "when": [
        [
          "value",
          "shape"
        ],
        [
          "feature",
          "topic"
        ]
      ],
      "never": [
        "map",
        "direct"
      ],
      "why": "the parts an item is built of never say what it is about"
    },
    {
      "when": [
        [
          "value",
          "shape"
        ],
        [
          "feature",
          "party"
        ]
      ],
      "never": [
        "map",
        "direct"
      ],
      "why": "the parts an item is built of never say who it is with"
    },
    {
      "when": [
        [
          "halted",
          "no"
        ],
        [
          "provider",
          "compiled"
        ],
        [
          "value",
          "text"
        ],
        [
          "feature",
          "topic"
        ]
      ],
      "always": "map",
      "why": "what the owner's content is about is read in its own words"
    }
  ],
