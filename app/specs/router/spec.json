{
  "name": "prism-router",
  "title": "Prism R4 Router",
  "facet": {
    "prefix": "router",
    "module": "PrismRouter",
    "request": "RouterRequest"
  },
  "purpose": "Decides, for one value of one piece of content coming into the Prism, whether one feature of the Prism maps it: the R4 router sends each value of the content's own schema through the features compiled into the Prism, so the Prism holds the owner's data in its own terms. A value the source's schema already types is mapped straight, free text is read by every compiled feature, a feature whose compiled model is missing is skipped, bytes that are not the compiled model never touch the owner's data, and the kill switch stops every mapping.",
  "fields": [
    {
      "name": "source",
      "values": [
        "note",
        "message",
        "calendar",
        "contact"
      ],
      "means": "the schema the content arrived in: the owner's own words, a mail message, a calendar event, or a contact card"
    },
    {
      "name": "value",
      "values": [
        "text",
        "subject",
        "start",
        "party",
        "shape"
      ],
      "means": "which value of that schema: free text, a subject or summary line, a start time the schema types, the person the schema names, or the shape of the parts it is built of (which headers, parts, attendees and links it has, never what they say)"
    },
    {
      "name": "feature",
      "values": [
        "time",
        "intent",
        "party",
        "meaning",
        "kind",
        "topic"
      ],
      "means": "the Prism feature to map it onto: when it happens, what it asks of the owner (a task, an event, a question or a fact), who it is with, what it means, what kind of thing it is (a person writing, an invitation, an update, a receipt, travel or a notice), and what it is about in the words the owner's own content keeps using"
    },
    {
      "name": "provider",
      "values": [
        "compiled",
        "absent",
        "mismatch"
      ],
      "means": "the model compiled into the Prism that provides the feature: present with its pinned bytes, absent, or present with other bytes"
    },
    {
      "name": "halted",
      "values": [
        "no",
        "yes"
      ],
      "means": "whether the owner pressed the kill switch"
    }
  ],
  "outcomes": [
    "map",
    "direct",
    "skip",
    "refuse"
  ],
  "meanings": {
    "map": "a compiled feature maps the value",
    "direct": "the value is mapped straight by its schema",
    "skip": "the feature is passed over",
    "refuse": "the value is not mapped"
  },
