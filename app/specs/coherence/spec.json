{
  "comment": "The Prism's coherence: every facet as one high-definition model with typed ports, and the flow that binds them into one runtime, after verdant resonance's MetaModel interface/composition elements and its functor bus. tools/coherence/gen.py checks the flow (every port produced and consumed, every root facet live or sealed by PrismHost, every place fed, every act and setting driven) and writes site/coherence/coherence.mjs, which the page runs on.",
  "ports": [
    {
      "key": "owner",
      "means": "the owner's own press, words or files"
    },
    {
      "key": "content",
      "means": "bytes the owner brought into this browser"
    },
    {
      "key": "item",
      "means": "one item with its media, domains and time"
    },
    {
      "key": "kept",
      "means": "an item kept in the vault under its label"
    },
    {
      "key": "span",
      "means": "how two intervals relate"
    },
    {
      "key": "draft",
      "means": "an outbound item shown word for word"
    },
    {
      "key": "sent",
      "means": "what left for the owner's own app"
    },
    {
      "key": "answer",
      "means": "what the owner is shown"
    },
    {
      "key": "object",
      "means": "an object named by its kappa label, sha256:<hex>, re-derived in this browser"
    }
  ],
  "facets": [
    {
      "key": "host",
      "line": "host",
      "modules": [
        "site/card.mjs"
      ],
      "in": [
        "owner"
      ],
      "out": [
        "content"
      ],
      "drives": {
        "settings": [
          "device"
        ]
      }
    },
    {
      "key": "folder",
