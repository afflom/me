        "acts": [
          "write",
          "event",
          "share"
        ],
        "settings": [
          "quiet"
        ]
      }
    },
    {
      "key": "r4",
      "line": "r4",
      "sealed": "R4 no longer speaks on the page; it routes incoming content onto the Prism's features through the router facet"
    },
    {
      "key": "model",
      "line": "model",
      "sealed": "a compiled model's bytes are admitted when the router's meaning feature first loads one; no feature needs a model's bytes yet"
    },
    {
      "key": "learn",
      "line": "learn",
      "modules": [
        "site/resonance/resonance.mjs"
      ],
      "in": [
        "answer"
      ],
      "out": [
        "answer"
      ],
      "drives": {
        "places": [
          "today",
          "conversations",
          "people",
          "calendar",
          "tasks",
          "places",
          "money",
          "things",
