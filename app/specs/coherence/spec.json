    },
    {
      "key": "kappa",
      "line": "kappa",
      "sealed": "admits an object under its kappa label; no page caller until the uorc ingest facet lands"
    },
    {
      "key": "holon",
      "line": "holon",
      "sealed": "reconciles owner and Prism from resonance signals; no page caller yet; the observer wires to resonance's onResonance next"
    },
    {
      "key": "curate",
      "line": "curate",
      "sealed": "tunes the parameters a facet marks tunable from resonance signals; no page caller yet; the observer wires to resonance's onResonance next"
    },
