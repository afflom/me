      {"key": "raised", "sets": ["muted", "secondary", "sidebar", "info-subtle"], "dark": "#17392b", "light": "#e5ede6"},
      {"key": "hover", "sets": ["accent", "accent-pressed"], "dark": "#1e4636", "light": "#d9e5db"},
      {"key": "ink", "sets": ["foreground", "card-foreground", "popover-foreground", "secondary-foreground", "accent-foreground", "sidebar-foreground", "sidebar-accent-foreground", "link", "link-hover"], "dark": "#eff7f1", "light": "#0b1d15"},
