  "look": {
    "comment": "The Prism's look, after verdant resonance's interface without its world: an abyss-green ground, verdant, solar and crystal accents, a display serif over a sans and a mono. Each tone takes the brand variables it lists, in both themes; gen.py refuses a pair below its contrast.",
    "themes": ["dark", "light"],
    "tones": [
      {"key": "ground", "sets": ["background"], "dark": "#0c2219", "light": "#f1f5f0"},
      {"key": "surface", "sets": ["card", "popover"], "dark": "#123024", "light": "#ffffff"},
      {"key": "raised", "sets": ["muted", "secondary", "sidebar", "info-subtle"], "dark": "#17392b", "light": "#e5ede6"},
      {"key": "hover", "sets": ["accent", "accent-pressed"], "dark": "#1e4636", "light": "#d9e5db"},
      {"key": "ink", "sets": ["foreground", "card-foreground", "popover-foreground", "secondary-foreground", "accent-foreground", "sidebar-foreground", "sidebar-accent-foreground", "link", "link-hover"], "dark": "#eff7f1", "light": "#0b1d15"},
      {"key": "muted", "sets": ["muted-foreground", "info"], "dark": "#bfd8c9", "light": "#3b5749"},
      {"key": "faint", "sets": ["muted-foreground-subtle"], "dark": "#9cc2ae", "light": "#56705f"},
      {"key": "line", "sets": ["border", "input", "border-solid", "sidebar-border", "info-border"], "dark": "#2f5a48", "light": "#cbd9ce"},
      {"key": "lineStrong", "sets": ["border-strong", "ring", "sidebar-ring"], "dark": "#4f8169", "light": "#9fb6a6"},
      {"key": "solar", "sets": ["primary", "brand", "sidebar-primary", "chart-1"], "dark": "#f5ca5c", "light": "#e7b23a"},
      {"key": "solarHover", "sets": ["primary-hover"], "dark": "#f8d982", "light": "#efc45f"},
      {"key": "onSolar", "sets": ["primary-foreground", "brand-foreground", "sidebar-primary-foreground"], "dark": "#0a1a13", "light": "#0b1d15"},
      {"key": "verdant", "sets": ["success", "chart-2"], "dark": "#47df9c", "light": "#11744a"},
      {"key": "crystal", "sets": ["chart-3"], "dark": "#5cc8f2", "light": "#0a6a90"},
      {"key": "danger", "sets": ["destructive"], "dark": "#ff8f80", "light": "#b42318"},
      {"key": "warning", "sets": ["warning"], "dark": "#f0a860", "light": "#97530a"}
