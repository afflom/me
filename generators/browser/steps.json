{
  "comment": "The steps of the browser program (generators/browser/), run in order by tools/generators/run.sh. A step reads repository files and the .gen/ outputs of this program's earlier steps only. deviceformats writes site/device/formats.mjs from app/src/PrismDevice.lex.tex and refuses a file extension whose registration (app/specs/oracle/media-types) does not state it as the model quotes it.",
  "steps": [
    {
      "generator": "browserindex",
      "split": "app/src/PrismBrowser.lex.tex",
      "output": ".gen/browser-index"
    },
    {
      "generator": "browserprobe",
      "inputs": [
        ".gen/browser-index"
      ],
      "output": "site/device/probe.mjs"
    },
    {
      "generator": "deviceformats",
      "inputs": [
        "app/specs/oracle/media-types/application-mbox.txt",
        "app/specs/oracle/media-types/text-calendar.txt",
        "app/specs/oracle/media-types/text-vcard.txt",
        "app/src/PrismDevice.lex.tex"
      ],
      "output": "site/device/formats.mjs"
    },
    {
      "generator": "browsergateseen",
      "split": "app/specs/oracle/web-algorithms/file-system-access/algorithms.json",
      "breakBefore": "^    [{]$",
      "inputs": [
        "app/src/PrismBrowserGates.lex.tex"
      ],
      "output": ".gen/gate-seen-0"
    },
    {
      "generator": "browsergateseen",
      "split": "app/specs/oracle/web-algorithms/contact-picker/algorithms.json",
      "breakBefore": "^    [{]$",
      "inputs": [
        "app/src/PrismBrowserGates.lex.tex"
      ],
      "output": ".gen/gate-seen-1"
