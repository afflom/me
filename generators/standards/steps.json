{
  "comment": "The steps of the standards program (generators/standards/), run in order by tools/generators/run.sh. A step reads repository files and the .gen/ outputs of this program's earlier steps only.",
  "steps": [
    {
      "generator": "wcagfacts",
      "split": "app/specs/standards/upstream/wcag.json",
      "output": ".gen/wcag-facts"
    },
    {
      "generator": "wcag",
      "inputs": [
        ".gen/wcag-facts"
      ],
      "output": "test/standards/generated/wcag-2.2.json"
    },
    {
      "generator": "ariafacts",
      "split": "app/specs/standards/upstream/wai-aria-1.2.html",
      "output": ".gen/aria-facts"
    },
    {
      "generator": "aria",
      "inputs": [
        ".gen/aria-facts"
      ],
      "output": "test/standards/generated/wai-aria-1.2.json"
    },
    {
      "generator": "irp",
      "split": "app/specs/standards/upstream/scxml-irp-manifest.xml",
      "output": "test/standards/generated/w3c-scxml-1.0.json"
    },
    {
      "generator": "sosa",
      "inputs": [
        "app/specs/standards/upstream/sosa.ttl"
      ],
      "output": "test/standards/generated/w3c-sosa-ssn.json"
    },
    {
      "generator": "sosatable",
      "inputs": [
        "app/specs/standards/upstream/sosa.ttl"
      ],
      "output": "app/src/PrismSosaTable.lex.tex"
    },
    {
      "generator": "mftests",
      "inputs": [
        "app/specs/message/upstream/bidi.json"
      ],
      "output": "test/standards/generated/unicode-messageformat-2/bidi.json"
    },
    {
      "generator": "mftests",
      "inputs": [
        "app/specs/message/upstream/data-model-errors.json"
      ],
      "output": "test/standards/generated/unicode-messageformat-2/data-model-errors.json"
    },
    {
      "generator": "mftests",
      "inputs": [
        "app/specs/message/upstream/fallback.json"
      ],
      "output": "test/standards/generated/unicode-messageformat-2/fallback.json"
    },
    {
      "generator": "mftests",
      "inputs": [
        "app/specs/message/upstream/functions/currency.json"
      ],
      "output": "test/standards/generated/unicode-messageformat-2/functions-currency.json"
    },
    {
      "generator": "mftests",
      "inputs": [
        "app/specs/message/upstream/functions/date.json"
      ],
      "output": "test/standards/generated/unicode-messageformat-2/functions-date.json"
    },
    {
      "generator": "mftests",
      "inputs": [
        "app/specs/message/upstream/functions/datetime.json"
      ],
      "output": "test/standards/generated/unicode-messageformat-2/functions-datetime.json"
    },
    {
      "generator": "mftests",
      "inputs": [
        "app/specs/message/upstream/functions/integer.json"
      ],
      "output": "test/standards/generated/unicode-messageformat-2/functions-integer.json"
    },
    {
      "generator": "mftests",
      "inputs": [
        "app/specs/message/upstream/functions/number.json"
      ],
      "output": "test/standards/generated/unicode-messageformat-2/functions-number.json"
    },
    {
      "generator": "mftests",
      "inputs": [
        "app/specs/message/upstream/functions/offset.json"
      ],
      "output": "test/standards/generated/unicode-messageformat-2/functions-offset.json"
    },
    {
      "generator": "mftests",
      "inputs": [
        "app/specs/message/upstream/functions/percent.json"
      ],
      "output": "test/standards/generated/unicode-messageformat-2/functions-percent.json"
    },
    {
      "generator": "mftests",
      "inputs": [
        "app/specs/message/upstream/functions/string.json"
      ],
      "output": "test/standards/generated/unicode-messageformat-2/functions-string.json"
    },
    {
      "generator": "mftests",
      "inputs": [
        "app/specs/message/upstream/functions/time.json"
      ],
      "output": "test/standards/generated/unicode-messageformat-2/functions-time.json"
    },
    {
      "generator": "mftests",
      "inputs": [
        "app/specs/message/upstream/pattern-selection.json"
      ],
      "output": "test/standards/generated/unicode-messageformat-2/pattern-selection.json"
    },
    {
      "generator": "mftests",
      "inputs": [
        "app/specs/message/upstream/syntax-errors.json"
      ],
      "output": "test/standards/generated/unicode-messageformat-2/syntax-errors.json"
    },
    {
      "generator": "mftests",
      "inputs": [
        "app/specs/message/upstream/syntax.json"
      ],
      "output": "test/standards/generated/unicode-messageformat-2/syntax.json"
    },
    {
      "generator": "mftests",
      "inputs": [
        "app/specs/message/upstream/u-options.json"
      ],
      "output": "test/standards/generated/unicode-messageformat-2/u-options.json"
    },
    {
      "generator": "accname",
      "split": "app/specs/standards/upstream/accname-1.2.html",
      "output": "test/standards/generated/accname-1.2.jsonl"
    }
  ]
}
