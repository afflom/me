{
  "comment": "The steps of the standards program (generators/standards/), run in order by tools/generators/run.sh. A step reads repository files and the .gen/ outputs of this program's earlier steps only.",
  "steps": [
    {
      "generator": "wcagfacts",
      "split": "app/specs/standards/upstream/wcag.json",
      "output": ".gen/wcag-facts"
    },
    {
      "generator": "wcag",
      "inputs": [
        ".gen/wcag-facts"
      ],
      "output": "test/standards/generated/wcag-2.2.json"
    },
    {
      "generator": "ariafacts",
      "split": "app/specs/standards/upstream/wai-aria-1.2.html",
      "output": ".gen/aria-facts"
    },
    {
      "generator": "aria",
      "inputs": [
        ".gen/aria-facts"
      ],
      "output": "test/standards/generated/wai-aria-1.2.json"
    },
    {
      "generator": "irp",
      "split": "app/specs/standards/upstream/scxml-irp-manifest.xml",
      "output": "test/standards/generated/w3c-scxml-1.0.json"
    },
    {
      "generator": "sosa",
      "inputs": [
        "app/specs/standards/upstream/sosa.ttl"
      ],
      "output": "test/standards/generated/w3c-sosa-ssn.json"
    },
    {
      "generator": "sosatable",
      "inputs": [
        "app/specs/standards/upstream/sosa.ttl"
      ],
      "output": "app/src/PrismSosaTable.lex.tex"
    },
    {
      "generator": "sensesevents",
      "split": "app/specs/standards/texts/c256f809479d98aa23d71bbd1658b3800ea9f13f41ca56e59c8d2de1b31cbfcb",
      "breakBefore": "^[0-9]+[.][0-9.]*[.]? ",
      "output": ".gen/senses-events"
    },
    {
      "generator": "sensescases",
      "inputs": [
        ".gen/senses-events",
        "app/specs/senses/clocks.json"
      ],
      "output": "app/specs/senses/observed/spec.json"
    },
    {
      "generator": "turtle",
      "split": "app/specs/standards/upstream/turtle-manifest.ttl",
      "breakBefore": "^<#",
      "output": "test/standards/generated/w3c-turtle-1.1.jsonl"
    }
  ]
}
