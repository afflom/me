{
  "comment": "The steps of the facets program (generators/facets/), run in order by tools/generators/run.sh. A step reads repository files and the .gen/ outputs of this program's earlier steps only.",
  "steps": [
    {
      "generator": "table",
      "inputs": [
        "app/specs/resonance/spec.json"
      ],
      "output": "site/resonance/table.mjs"
    },
    {
      "generator": "table",
      "split": "app/specs/router/spec.json",
      "output": "site/router/table.mjs"
    },
    {
      "generator": "holon",
      "inputs": [
        "app/specs/holon/spec.json",
        "app/specs/curate/spec.json"
      ],
      "output": "site/holon/table.mjs"
    }
  ]
}
