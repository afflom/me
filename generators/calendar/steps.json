{
  "comment": "The steps of the calendar program (generators/calendar/), run in order by tools/generators/run.sh: the IANA iCalendar registries and RFC 5545 section 3 into the reader's registry and ST-01's inventory of RFC 5545's registered elements.",
  "steps": [
    {
      "generator": "icalxml",
      "split": "app/specs/calendar/upstream/icalendar.xml",
      "output": ".gen/ical-iana"
    },
    {
      "generator": "icalrfc",
      "split": "app/specs/standards/texts/c256f809479d98aa23d71bbd1658b3800ea9f13f41ca56e59c8d2de1b31cbfcb",
      "breakBefore": "^[0-9]+[.][0-9.]*[.]? ",
      "output": ".gen/ical-defs"
    },
    {
      "generator": "icalregistry",
      "inputs": [
        ".gen/ical-iana",
        ".gen/ical-defs",
        "app/specs/calendar/spec.json"
      ],
      "output": "site/calendar/registry.mjs"
    },
    {
      "generator": "icalinventory",
      "inputs": [
        ".gen/ical-iana",
        "app/specs/calendar/spec.json"
      ],
      "output": "test/standards/generated/iana-icalendar.json"
    }
  ]
}
