{
  "comment": "The steps of the calendar program (generators/calendar/), run in order by tools/generators/run.sh: the IANA iCalendar registries and RFC 5545 section 3 into the reader's registry and ST-01's inventory of RFC 5545's registered elements, and the examples of RFC 5545 and of RFC 5546 (section 4) into the suite that holds the reader to each registered element (test/calendar.registry.test.mjs).",
  "steps": [
    {
      "generator": "icalxml",
      "split": "app/specs/calendar/upstream/icalendar.xml",
      "output": ".gen/ical-iana"
    },
    {
      "generator": "icalrfc",
      "split": "app/specs/standards/texts/c256f809479d98aa23d71bbd1658b3800ea9f13f41ca56e59c8d2de1b31cbfcb",
      "breakBefore": "^[0-9]+[.][0-9.]*[.]? ",
      "output": ".gen/ical-defs"
    },
    {
      "generator": "icalregistry",
      "inputs": [
        ".gen/ical-iana",
        ".gen/ical-defs",
        "app/specs/calendar/spec.json"
      ],
      "output": "site/calendar/registry.mjs"
    },
    {
      "generator": "icalinventory",
      "inputs": [
        ".gen/ical-iana",
        "app/specs/calendar/spec.json"
      ],
      "output": "test/standards/generated/iana-icalendar.json"
    },
    {
      "generator": "icalexamples",
      "split": "app/specs/standards/texts/c256f809479d98aa23d71bbd1658b3800ea9f13f41ca56e59c8d2de1b31cbfcb",
      "breakBefore": "^[0-9]+[.][0-9.]*[.]? ",
      "output": "test/standards/generated/rfc5545-examples.txt"
    },
    {
      "generator": "icalfound",
      "split": "test/standards/generated/rfc5545-examples.txt",
      "inputs": [
        ".gen/ical-iana",
        "app/specs/calendar/spec.json"
      ],
      "output": ".gen/ical-found"
    },
    {
      "generator": "icaltipexamples",
      "split": "app/specs/standards/texts/a7aad5fd02f4e226e09f5092f0e985131c66af530400b097a6c35bbba01b558a",
      "breakBefore": "^[0-9]+[.][0-9.]*[.]? ",
      "output": "test/standards/generated/rfc5546-examples.txt"
    },
    {
      "generator": "icaltipfound",
      "split": "test/standards/generated/rfc5546-examples.txt",
      "inputs": [
        ".gen/ical-iana",
        "app/specs/calendar/spec.json"
      ],
      "output": ".gen/ical-found-tip"
    },
    {
      "generator": "icalsuite",
      "inputs": [
        ".gen/ical-iana",
        "app/specs/calendar/spec.json",
        ".gen/ical-found",
        ".gen/ical-found-tip"
      ],
      "output": "test/calendar.registry.test.mjs"
    }
  ]
}
