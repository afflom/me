{
  "comment": "The steps of the system program (generators/system/), run in order by tools/generators/run.sh. A step reads repository files and the .gen/ outputs of this program's earlier steps only.",
  "steps": [
    {
      "generator": "registerkey",
      "each": {
        "files": "app/specs/standards/register/*.json",
        "file": "app/specs/standards/spec.json"
      },
      "output": ".gen/register-keys"
    },
    {
      "generator": "systemcheck",
      "inputs": [
        "app/specs/system/spec.json",
        "app/prompts/set.json",
        ".gen/register-keys"
      ],
      "output": ".gen/system-check"
    },
    {
      "generator": "archindex",
      "split": "app/src/Architecture.lex.tex",
      "output": ".gen/arch-index"
    },
    {
      "generator": "system",
      "inputs": [
        "app/specs/system/spec.json",
        ".gen/arch-index"
      ],
      "output": "app/src/PrismSystem.lex.tex"
    }
  ]
}
