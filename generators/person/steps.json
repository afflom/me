{
  "comment": "The steps of the person program (generators/person/), run in order by tools/generators/run.sh. A step reads repository files and the .gen/ outputs of this program's earlier steps only.",
  "steps": [
    {
      "generator": "icftree",
      "split": "app/specs/oracle/icf/SimpleTabulation-ICF-en.txt",
      "output": ".gen/icf-tree"
    },
    {
      "generator": "icftreecheck",
      "inputs": [
        ".gen/icf-tree"
      ],
      "output": ".gen/icf-tree-checked"
    },
    {
      "generator": "icfids",
      "split": "app/specs/oracle/icf/SimpleTabulation-ICF-en.txt",
      "output": ".gen/icf-ids"
    },
    {
      "generator": "icfunique",
      "inputs": [
        ".gen/icf-ids"
      ],
      "output": ".gen/icf-unique"
    },
    {
      "generator": "icf",
      "split": "app/specs/oracle/icf/SimpleTabulation-ICF-en.txt",
      "output": "site/person/icf-rows.mjs"
    }
  ]
}
