{
  "comment": "The steps of the person program (generators/person/), run in order by tools/generators/run.sh. A step reads repository files and the .gen/ outputs of this program's earlier steps only.",
  "steps": [
    {
      "generator": "icftree",
      "split": "app/specs/oracle/icf/SimpleTabulation-ICF-en.txt",
      "output": ".gen/icf-tree"
    },
    {
      "generator": "icftreecheck",
      "inputs": [
        ".gen/icf-tree"
      ],
      "output": ".gen/icf-tree-checked"
    },
    {
      "generator": "icfids",
      "split": "app/specs/oracle/icf/SimpleTabulation-ICF-en.txt",
      "output": ".gen/icf-ids"
    },
    {
      "generator": "icfunique",
      "inputs": [
        ".gen/icf-ids"
      ],
      "output": ".gen/icf-unique"
    },
    {
      "generator": "icf",
      "split": "app/specs/oracle/icf/SimpleTabulation-ICF-en.txt",
      "output": "site/person/icf-rows.mjs"
    },
    {
      "generator": "icfmodule",
      "inputs": [
        "app/specs/oracle/spec.json"
      ],
      "output": "site/person/icf.mjs"
    },
    {
      "generator": "icflean",
      "split": "app/specs/oracle/icf/SimpleTabulation-ICF-en.txt",
      "output": ".gen/icf-lean-rows"
    },
    {
      "generator": "icfleannames",
      "split": "app/specs/oracle/icf/SimpleTabulation-ICF-en.txt",
      "output": ".gen/icf-lean-names"
    },
    {
      "generator": "icfleanend",
      "inputs": [
        ".gen/icf-lean-names"
      ],
      "after": ".gen/icf-lean-rows",
      "output": "app/src/PersonIcf.lex.tex"
    },
    {
      "generator": "icfreqs",
      "split": "app/specs/oracle/icf/SimpleTabulation-ICF-en.txt",
      "output": "test/standards/generated/who-icf.jsonl"
    },
    {
      "generator": "vocabnames",
      "split": "site/vocab/register.json",
      "output": ".gen/vocab-name-rows"
    },
    {
      "generator": "vocabnamenames",
      "split": "site/vocab/register.json",
      "output": ".gen/vocab-name-names"
    },
    {
      "generator": "vocabnamesend",
      "inputs": [
        ".gen/vocab-name-names"
      ],
      "after": ".gen/vocab-name-rows",
      "output": "app/src/VocabNames.lex.tex"
    },
    {
      "generator": "schemaparents",
      "split": "app/specs/standards/texts/0a4b8c4c910fc831ec8695196510973390906a5ee34dc6b862dfec4d21a12f74",
      "breakBefore": "^    [{]$",
      "output": ".gen/schemaorg-person-types"
    },
    {
      "generator": "schemaroots",
      "split": "app/specs/standards/texts/0a4b8c4c910fc831ec8695196510973390906a5ee34dc6b862dfec4d21a12f74",
      "breakBefore": "^    [{]$",
      "inputs": [
        ".gen/schemaorg-person-types"
      ],
      "output": ".gen/schemaorg-person-roots"
    },
    {
      "generator": "schemanames",
      "split": "app/specs/standards/texts/0a4b8c4c910fc831ec8695196510973390906a5ee34dc6b862dfec4d21a12f74",
      "breakBefore": "^    [{]$",
      "inputs": [
        ".gen/schemaorg-person-types"
      ],
      "output": ".gen/schemaorg-person-names"
    },
    {
      "generator": "schemareqs",
      "inputs": [
        ".gen/schemaorg-person-names"
      ],
      "output": "test/standards/generated/schemaorg-person.jsonl"
    },
    {
      "generator": "schemapin",
      "inputs": [
        ".gen/schemaorg-person-names"
      ],
      "output": "app/src/PersonSchemaPin.lex.tex"
    },
    {
      "generator": "schemaranges",
      "split": "app/specs/standards/texts/0a4b8c4c910fc831ec8695196510973390906a5ee34dc6b862dfec4d21a12f74",
      "breakBefore": "^    [{]$",
      "inputs": [
        ".gen/schemaorg-person-names"
      ],
      "output": ".gen/schemaorg-person-ranges"
    },
    {
      "generator": "modelbase",
      "split": "app/src/Foundation/Person/V1/Model.lex.tex",
      "breakBefore": "^definition[{]$",
      "output": ".gen/person-model-base"
    },
    {
      "generator": "vocabcopy",
      "each": {
        "file": "app/specs/vocab/spec.json",
        "array": ".propertyFloors"
      },
      "output": ".gen/person-floors"
    },
    {
      "generator": "vocabcopy",
      "each": {
        "file": "app/specs/vocab/spec.json",
        "array": ".anchors"
      },
      "output": ".gen/person-anchors"
    },
    {
      "generator": "personfloor",
      "each": {
        "file": "app/specs/vocab/spec.json",
        "array": ".domains"
      },
      "inputs": [
        ".gen/person-anchors"
      ],
      "output": ".gen/person-floor"
    },
    {
      "generator": "personmorerows",
      "inputs": [
        ".gen/schemaorg-person-ranges",
        ".gen/person-model-base",
        ".gen/person-floors",
        ".gen/person-floor"
      ],
      "output": ".gen/person-more-rows"
    },
    {
      "generator": "personmore",
      "inputs": [
        ".gen/person-more-rows",
        ".gen/person-floor"
      ],
      "output": "app/src/Foundation/Person/V1/More.lex.tex"
    }
  ]
}
