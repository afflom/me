{
  "comment": "The steps tools/generators/run.sh runs, in order; each names the program (generators/<program>/) whose generator writes its output. requestMaximum is the programs' request bound (their Generators.lex.tex); pieceMaximum leaves room in it for the request line and the archive's headers.",
  "requestMaximum": 32768,
  "pieceMaximum": 30720,
  "steps": [
    {
      "program": "system",
      "generator": "registerkey",
      "each": {
        "file": "app/specs/standards/spec.json",
        "array": ".standards"
      },
      "output": ".gen/register-keys"
    },
    {
      "program": "system",
      "generator": "systemcheck",
      "inputs": [
        "app/specs/system/spec.json",
        "app/prompts/set.json",
        ".gen/register-keys"
      ],
      "output": ".gen/system-check"
    },
    {
      "program": "system",
      "generator": "archindex",
      "split": "app/src/Architecture.lex.tex",
      "output": ".gen/arch-index"
    },
    {
      "program": "system",
      "generator": "system",
      "inputs": [
        "app/specs/system/spec.json",
        ".gen/arch-index"
      ],
      "output": "app/src/PrismSystem.lex.tex"
    },
    {
      "program": "product",
      "generator": "pdsurface",
      "inputs": [
        "app/specs/product/spec.json",
        "app/specs/surface/spec.json"
      ],
      "output": ".gen/pd-surface"
    },
    {
      "program": "product",
      "generator": "pdwalks",
      "inputs": [
        "test/product/journeys.mjs"
      ],
      "output": ".gen/pd-walks"
    },
    {
      "program": "product",
      "generator": "pdjourneyfact",
      "glob": [
        "app/specs/product/journeys/*.json"
      ],
      "output": ".gen/pd-journeys"
    },
    {
      "program": "product",
      "generator": "pdjourney",
      "glob": [
        "app/specs/product/journeys/*.json"
      ],
      "inputs": [
        ".gen/pd-walks"
      ],
      "output": ".gen/pd-journey-check"
    },
    {
      "program": "product",
      "generator": "pdorphans",
      "inputs": [
        ".gen/pd-walks",
        ".gen/pd-journeys"
      ],
      "output": ".gen/pd-orphans"
    },
    {
      "program": "product",
      "generator": "stem",
      "glob": [
        "app/specs/coherence/facets/*.json"
      ],
      "output": ".gen/pd-coherence"
    },
    {
      "program": "product",
      "generator": "stem",
      "glob": [
        "app/specs/product/facets/*.json"
      ],
      "output": ".gen/pd-facets"
    },
    {
      "program": "product",
      "generator": "pdfacet",
      "glob": [
        "app/specs/product/facets/*.json"
      ],
      "inputs": [
        ".gen/pd-coherence",
        ".gen/pd-journeys"
      ],
      "output": ".gen/pd-facet-check"
    },
    {
      "program": "product",
      "generator": "pdfacetsmissing",
      "inputs": [
        ".gen/pd-coherence",
        ".gen/pd-facets"
      ],
      "output": ".gen/pd-facets-missing"
    },
    {
      "program": "product",
      "generator": "pdrefs",
      "glob": [
        "app/specs/product/features/*.json"
      ],
      "output": ".gen/pd-refs"
    },
    {
      "program": "product",
      "generator": "pdindex",
      "glob": [
        "site/*.mjs",
        "test/*.mjs",
        ":(exclude)site/vendor/*"
      ],
      "inputs": [
        ".gen/pd-refs"
      ],
      "output": ".gen/pd-index"
    },
    {
      "program": "product",
      "generator": "stem",
      "glob": [
        "app/specs/product/quality/*.json"
      ],
      "output": ".gen/pd-quality"
    },
    {
      "program": "product",
      "generator": "pdheld",
      "glob": [
        "app/specs/product/features/*.json"
      ],
      "output": ".gen/pd-held"
    },
    {
      "program": "product",
      "generator": "pdfeature",
      "glob": [
        "app/specs/product/features/*.json"
      ],
      "inputs": [
        ".gen/pd-journeys",
        ".gen/pd-index",
        ".gen/pd-quality"
      ],
      "output": ".gen/pd-feature-check"
    },
    {
      "program": "product",
      "generator": "pdmeasures",
      "glob": [
        "app/specs/product/quality/*.json"
      ],
      "output": ".gen/pd-measures"
    },
    {
      "program": "product",
      "generator": "pdhits",
      "glob": [
        "site/*.mjs",
        "test/*.mjs",
        ":(exclude)site/vendor/*"
      ],
      "inputs": [
        ".gen/pd-measures"
      ],
      "output": ".gen/pd-hits"
    },
    {
      "program": "product",
      "generator": "pdquality",
      "glob": [
        "app/specs/product/quality/*.json"
      ],
      "inputs": [
        "app/specs/product/spec.json",
        ".gen/pd-held",
        ".gen/pd-hits"
      ],
      "output": ".gen/pd-quality-check"
    }
  ]
}
