{
  "comment": "The steps tools/generators/run.sh runs, in order; each names the program (generators/<program>/) whose generator writes its output. requestMaximum is the programs' request bound (their Generators.lex.tex); pieceMaximum leaves room in it for the request line and the archive's headers.",
  "requestMaximum": 32768,
  "pieceMaximum": 30720,
  "steps": [
    {
      "program": "system",
      "generator": "registerkey",
      "each": {
        "file": "app/specs/standards/spec.json",
        "array": ".standards"
      },
      "output": ".gen/register-keys"
    },
    {
      "program": "system",
      "generator": "systemcheck",
      "inputs": [
        "app/specs/system/spec.json",
        "app/prompts/set.json",
        ".gen/register-keys"
      ],
      "output": ".gen/system-check"
    },
    {
      "program": "system",
      "generator": "archindex",
      "split": "app/src/Architecture.lex.tex",
      "output": ".gen/arch-index"
    },
    {
      "program": "system",
      "generator": "system",
      "inputs": [
        "app/specs/system/spec.json",
        ".gen/arch-index"
      ],
      "output": "app/src/PrismSystem.lex.tex"
    },
    {
      "program": "calendar",
      "generator": "icalxml",
      "split": "upstream/icalendar.xml",
      "breakBefore": "<record[ >]|<registry ",
      "pinned": {
        "file": "app/specs/calendar/spec.json",
        "entries": [
          ".registry"
        ]
      },
      "output": ".gen/ical-iana"
    },
    {
      "program": "calendar",
      "generator": "icalrfc",
      "split": "upstream/rfc5545.txt",
      "breakBefore": "^[0-9]+[.][0-9.]*[.]? ",
      "pinned": {
        "file": "app/specs/calendar/spec.json",
        "entries": [
          ".text"
        ]
      },
      "output": ".gen/ical-defs"
    },
    {
      "program": "calendar",
      "generator": "icalregistry",
      "inputs": [
        ".gen/ical-iana",
        ".gen/ical-defs",
        "app/specs/calendar/spec.json"
      ],
      "output": "site/calendar/registry.mjs"
    }
  ]
}
