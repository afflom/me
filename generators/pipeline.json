{
  "comment": "The steps tools/generators/run.sh runs, in order; each names the program (generators/<program>/) whose generator writes its output. requestMaximum is the programs' request bound (their Generators.lex.tex); pieceMaximum leaves room in it for the request line and the archive's headers.",
  "requestMaximum": 32768,
  "pieceMaximum": 30720,
  "steps": [
    {
      "program": "system",
      "generator": "registerkey",
      "each": {
        "file": "app/specs/standards/spec.json",
        "array": ".standards"
      },
      "output": ".gen/register-keys"
    },
    {
      "program": "system",
      "generator": "systemcheck",
      "inputs": [
        "app/specs/system/spec.json",
        "app/prompts/set.json",
        ".gen/register-keys"
      ],
      "output": ".gen/system-check"
    },
    {
      "program": "system",
      "generator": "archindex",
      "split": "app/src/Architecture.lex.tex",
      "output": ".gen/arch-index"
    },
    {
      "program": "system",
      "generator": "system",
      "inputs": [
        "app/specs/system/spec.json",
        ".gen/arch-index"
      ],
      "output": "app/src/PrismSystem.lex.tex"
    },
    {
      "program": "standards",
      "generator": "wcagfacts",
      "split": "app/specs/standards/upstream/wcag.json",
      "output": ".gen/wcag-facts"
    },
    {
      "program": "standards",
      "generator": "wcag",
      "inputs": [
        ".gen/wcag-facts"
      ],
      "output": "test/standards/generated/wcag-2.2.json"
    },
    {
      "program": "standards",
      "generator": "ariafacts",
      "split": "app/specs/standards/upstream/wai-aria-1.2.html",
      "output": ".gen/aria-facts"
    },
    {
      "program": "standards",
      "generator": "aria",
      "inputs": [
        ".gen/aria-facts"
      ],
      "output": "test/standards/generated/wai-aria-1.2.json"
    }
  ]
}
