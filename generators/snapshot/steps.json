{
  "comment": "The steps of the snapshot program (generators/snapshot/), run in order by tools/generators/run.sh. jsonpatchoracle applies every case of the json-patch-tests suite (app/specs/oracle/json-patch-tests) as RFC 6902 says; jcspairs canonicalizes every input of the RFC 8785 author's test data (app/specs/oracle/json-canonicalization) and compares it with its output; jcsnumbers serializes every row of RFC 8785 Appendix B (app/specs/oracle/rfc8785) and writes the rows it held. Each refuses on any difference. shashort and shamonte hash every NIST CAVP SHA-256 message and Monte Carlo checkpoint (app/specs/oracle/nist-cavp-sha256) with the SHA-256 that snapshot addresses use; lockcheck hashes every vendored oracle file and refuses one whose SHA-256 is not the one its lock.json pins, or a file the lock does not list. snapshotvectors writes the acceptance vectors of the snapshot guest (app/specs/snapshot/spec.json) from those oracles: apply, every case of spec_tests.json (RFC 6902 Appendix A) as [document, patch], answered by the RFC 8785 form of its expected document or by refusal for an error case; canonical, every input of the RFC 8785 author's test data, answered by its output byte for byte; address, the same inputs, answered by sha256: and the SHA-256 of that output; sha256, every message of NIST CAVP SHA256ShortMsg.rsp as its Len and Msg lines, answered by its MD line. snapshotpatchvectors writes app/specs/snapshot-patch/spec.json, more acceptance vectors of the same guest: every case of json-patch-tests tests.json that states an outcome, as an apply request and its answer.",
  "steps": [
    {
      "generator": "jsonpatchoracle",
      "inputs": [
        "app/specs/oracle/json-patch-tests/spec_tests.json",
        "app/specs/oracle/json-patch-tests/tests.json"
      ],
      "output": ".gen/jsonpatch-oracle"
    },
    {
      "generator": "jcspairs",
      "inputs": [
        "app/specs/oracle/json-canonicalization/input/arrays.json",
        "app/specs/oracle/json-canonicalization/input/french.json",
        "app/specs/oracle/json-canonicalization/input/structures.json",
        "app/specs/oracle/json-canonicalization/input/unicode.json",
        "app/specs/oracle/json-canonicalization/input/values.json",
        "app/specs/oracle/json-canonicalization/input/weird.json",
        "app/specs/oracle/json-canonicalization/output/arrays.json",
        "app/specs/oracle/json-canonicalization/output/french.json",
        "app/specs/oracle/json-canonicalization/output/structures.json",
        "app/specs/oracle/json-canonicalization/output/unicode.json",
        "app/specs/oracle/json-canonicalization/output/values.json",
        "app/specs/oracle/json-canonicalization/output/weird.json"
      ],
      "output": ".gen/jcs-pairs"
    },
    {
      "generator": "jcsnumbers",
      "split": "app/specs/oracle/rfc8785/rfc8785-appendix-b.txt",
      "output": "app/specs/oracle/rfc8785/appendix-b.txt"
    },
    {
      "generator": "shashort",
      "inputs": [
        "app/specs/oracle/nist-cavp-sha256/SHA256ShortMsg.rsp"
      ],
      "output": ".gen/sha256-short"
    },
    {
      "generator": "shamonte",
      "inputs": [
        "app/specs/oracle/nist-cavp-sha256/SHA256Monte.rsp"
      ],
      "output": ".gen/sha256-monte"
    },
    {
      "generator": "lockcheck",
      "inputs": [
        "app/specs/oracle/json-canonicalization/input/arrays.json",
        "app/specs/oracle/json-canonicalization/input/french.json",
        "app/specs/oracle/json-canonicalization/input/structures.json",
        "app/specs/oracle/json-canonicalization/input/unicode.json",
        "app/specs/oracle/json-canonicalization/input/values.json",
        "app/specs/oracle/json-canonicalization/input/weird.json",
        "app/specs/oracle/json-canonicalization/lock.json",
        "app/specs/oracle/json-canonicalization/output/arrays.json",
        "app/specs/oracle/json-canonicalization/output/french.json",
        "app/specs/oracle/json-canonicalization/output/structures.json",
        "app/specs/oracle/json-canonicalization/output/unicode.json",
        "app/specs/oracle/json-canonicalization/output/values.json",
        "app/specs/oracle/json-canonicalization/output/weird.json"
      ],
      "output": ".gen/lock-json-canonicalization"
    },
    {
      "generator": "lockcheck",
      "inputs": [
        "app/specs/oracle/json-patch-tests/lock.json",
        "app/specs/oracle/json-patch-tests/spec_tests.json",
        "app/specs/oracle/json-patch-tests/tests.json"
      ],
      "output": ".gen/lock-json-patch-tests"
    },
    {
      "generator": "lockcheck",
      "inputs": [
        "app/specs/oracle/nist-cavp-sha256/SHA256Monte.rsp",
        "app/specs/oracle/nist-cavp-sha256/SHA256ShortMsg.rsp",
        "app/specs/oracle/nist-cavp-sha256/lock.json"
      ],
      "output": ".gen/lock-nist-cavp-sha256"
    },
    {
      "generator": "lockcheck",
      "inputs": [
        "app/specs/oracle/rfc8785/lock.json",
        "app/specs/oracle/rfc8785/rfc8785-appendix-b.txt"
      ],
      "output": ".gen/lock-rfc8785"
    },
    {
      "generator": "lockcheck",
      "inputs": [
        "app/specs/oracle/media-types/application-mbox.txt",
        "app/specs/oracle/media-types/lock.json",
        "app/specs/oracle/media-types/text-calendar.txt",
        "app/specs/oracle/media-types/text-vcard.txt"
      ],
      "output": ".gen/lock-media-types"
    },
    {
      "generator": "snapshotvectors",
      "inputs": [
        "app/specs/oracle/json-canonicalization/input/arrays.json",
        "app/specs/oracle/json-canonicalization/input/french.json",
        "app/specs/oracle/json-canonicalization/input/structures.json",
        "app/specs/oracle/json-canonicalization/input/unicode.json",
        "app/specs/oracle/json-canonicalization/input/values.json",
        "app/specs/oracle/json-canonicalization/input/weird.json",
        "app/specs/oracle/json-canonicalization/output/arrays.json",
        "app/specs/oracle/json-canonicalization/output/french.json",
        "app/specs/oracle/json-canonicalization/output/structures.json",
        "app/specs/oracle/json-canonicalization/output/unicode.json",
        "app/specs/oracle/json-canonicalization/output/values.json",
        "app/specs/oracle/json-canonicalization/output/weird.json",
        "app/specs/oracle/json-patch-tests/spec_tests.json",
        "app/specs/oracle/nist-cavp-sha256/SHA256ShortMsg.rsp"
      ],
      "output": "app/specs/snapshot/spec.json"
    },
    {
      "generator": "snapshotpatchvectors",
      "inputs": [
        "app/specs/oracle/json-patch-tests/tests.json"
      ],
      "output": "app/specs/snapshot-patch/spec.json"
    }
  ]
}
